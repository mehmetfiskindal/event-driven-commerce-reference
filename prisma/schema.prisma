generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  CREATED
  PENDING
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  INVENTORY_RESERVED
  INVENTORY_FAILED
}

model Order {
  id             String      @id @db.VarChar(64)
  userId         String      @map("user_id") @db.VarChar(64)
  status         OrderStatus
  totalAmount    Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency       String      @db.VarChar(8)
  requestId      String      @map("request_id") @db.VarChar(64)
  correlationId  String      @map("correlation_id") @db.VarChar(64)
  idempotencyKey String      @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  items          OrderItem[]

  @@index([userId], map: "idx_orders_user_id")
  @@index([correlationId], map: "idx_orders_correlation_id")
  @@index([createdAt], map: "idx_orders_created_at")
  @@map("orders")
}

model OrderItem {
  id        BigInt   @id @default(autoincrement())
  orderId   String   @map("order_id") @db.VarChar(64)
  productId String   @map("product_id") @db.VarChar(64)
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model ProcessedEvent {
  id            BigInt   @id @default(autoincrement())
  eventId       String   @map("event_id") @db.VarChar(64)
  eventType     String   @map("event_type") @db.VarChar(64)
  consumerName  String   @map("consumer_name") @db.VarChar(64)
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([eventId, consumerName], map: "processed_events_event_id_consumer_name_key")
  @@index([eventId, consumerName], map: "idx_processed_events_event_id_consumer_name")
  @@map("processed_events")
}
